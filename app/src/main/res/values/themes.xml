<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. Compose draws the real UI; this just sets a dark, no-action-bar
         shell with an ink window background so there's no white flash. -->
    <style name="Theme.Warden" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <!-- Launch (splash) theme: shield glyph on the ink field, then hands off to
         Theme.Warden once the app is ready. -->
    <style name="Theme.Warden.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Warden</item>
    </style>
</resources>
